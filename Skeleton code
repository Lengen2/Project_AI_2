# =============================================================================
# 1. KERNEL CONFIGURATION
# =============================================================================
# Kernel variance parameter specified in the assignment: sigma^2 = 0.25
SIGMA_SQUARED = 0.25
GAMMA = 1.0 / (2.0 * SIGMA_SQUARED)

def rbf_kernel(X1, X2):
    """Compute the RBF kernel matrix between two sets of input vectors.
    
    Args:
        X1: cvxopt matrix of shape (N1, D) where N1 is the number of samples and D is the dimensionality.
        X2: cvxopt matrix of shape (N2, D) where N2 is the number of samples and D is the dimensionality.
    
    Returns:
        K: cvxopt matrix of shape (N1, N2) containing the RBF kernel values.
    """
    # Ensure inputs are numpy arrays for distance computation
    if isinstance(X1, cvx.matrix):
        X1 = np.array(X1)
    if isinstance(X1, list):
        X1 = np.array(X1)

    if isinstance(X2, cvx.matrix):
        X2 = np.array(X2)
    if isinstance(X2, list):
        X2 = np.array(X2)

    # Handle single 1D input vectors by reshaping them to 2D    
    if X1.ndim == 1:
        X1 = X1.reshape(1, -1)
    if X2.ndim == 1:
        X2 = X2.reshape(1, -1)

    # Efficient squared Euclidean distance matrix computation using ||x - z||^2 = ||x||^2 + ||z||^2 - 2xz^T   
    # The double (*) means its squaring every element in the array, and then summing along axis 1 (rows) 
    # to get the squared norms of each vector
    dists = np.sum(X1**2, axis=1).reshape(-1, 1) + np.sum(X2**2, axis=1) - 2 * np.dot(X1, X2.T)
    
    # Apply the RBF kernel transformation (clip negative distances to 0 to avoid numerical issues)
    return np.exp(-GAMMA * np.maximum(dists, 0))

